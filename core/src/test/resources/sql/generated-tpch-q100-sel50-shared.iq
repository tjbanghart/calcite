where l.l_orderkey = o.o_orderkey and l.l_extendedprice <= 52950.00
group by o.o_orderstatus
order by o.o_orderstatus),

-- Q98: JoinAgg-LO-Stat-A3 (SharedJoinAgg) --
(select o.o_orderstatus, count(*) as cnt_1, max(l.l_tax) as max_tax, min(l.l_quantity) as min_quantity
from lineitem l, orders o
where l.l_orderkey = o.o_orderkey and l.l_extendedprice <= 52950.00
group by o.o_orderstatus
order by o.o_orderstatus),

-- Q99: JoinAgg-LO-Stat-A4 (SharedJoinAgg) --
(select o.o_orderstatus, max(l.l_tax) as max_tax
from lineitem l, orders o
where l.l_orderkey = o.o_orderkey and l.l_extendedprice <= 52950.00
group by o.o_orderstatus
order by o.o_orderstatus),

-- Q100: JoinAgg-LO-Stat-A5 (SharedJoinAgg) --
(select o.o_orderstatus, min(l.l_quantity) as min_quantity, sum(l.l_extendedprice) as sum_extendedprice
from lineitem l, orders o
where l.l_orderkey = o.o_orderkey and l.l_extendedprice <= 52950.00
group by o.o_orderstatus
order by o.o_orderstatus)
);
