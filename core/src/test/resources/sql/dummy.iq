!use tpch
!set outputformat mysql

# Skip all HepPlanner preprocessing (including calc conversion)
# and go directly to VolcanoPlanner for optimization
!set volcanoonly true

!set planner-rules "+COMBINE_SHARED_COMPONENTS"
MULTI(
-- TPC-H Query 1 --
(select
  l_returnflag,
  l_linestatus,
  sum(l_quantity) as sum_qty,
  sum(l_extendedprice) as sum_base_price,
  sum(l_extendedprice * (1 - l_discount)) as sum_disc_price,
  sum(l_extendedprice * (1 - l_discount) * (1 + l_tax)) as sum_charge,
  avg(l_quantity) as avg_qty,
  avg(l_extendedprice) as avg_price,
  avg(l_discount) as avg_disc,
  count(*) as count_order
from
  lineitem
group by
  l_returnflag,
  l_linestatus
order by
  l_returnflag,
  l_linestatus),

-- TPC-H Query 6 --
(select
  sum(l_extendedprice * l_discount) as revenue
from
  lineitem
where
  l_discount between 0.03 - 0.01 and 0.03 + 0.01
  and l_quantity < 24)
);
!plan

# do not modify this file, this is intended only for temporary debugging code
# End dummy.iq
